    <h1>🎨 MuizenMesh Webring Widget Demo</h1>
    <p>
        Explore different themes and configurations for the React/TypeScript widget. 
        This interactive demo shows all available options for integrating the MuizenMesh Webring into your projects.
    </p>
    
    <p>
        <strong>📁 Demo Files:</strong> 
        <a href="https://github.com/MuizenMesh/webring/tree/main/demo" target="_blank">View on GitHub</a> | 
        <a href="/interactive-demo/index.html" target="_blank">Open Interactive Demo</a> |
        <a href="/html-css-demo/" target="_blank">HTML/CSS Themes Demo</a>
    </p>

    <h2>🚀 Quick Start</h2>
    <p>Copy the widget files to your React project:</p>
    
    {% highlight 'bash' %}
npm install react next

# Copy these files to your project:
# - widgets/WebringWidget.tsx
# - widgets/WebringWidget.module.css  
# - widgets/types.ts
    {% endhighlight %}

    <h2>🎨 Available Themes</h2>
    
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 2rem; margin: 2rem 0;">
        <div style="border: 1px solid #ddd; border-radius: 8px; padding: 1rem;">
            <h3>🎯 Default Theme</h3>
            <p>Clean blue design with classic styling</p>
            {% highlight 'tsx' %}
<WebringWidget title="Community Links" />
            {% endhighlight %}
        </div>
        
        <div style="border: 1px solid #ddd; border-radius: 8px; padding: 1rem;">
            <h3>🎨 Minimal Theme</h3>
            <p>Subtle gray styling for minimal designs</p>
            {% highlight 'tsx' %}
<WebringWidget 
  theme="minimal" 
  size="small" 
  showDescription={false}
/>
            {% endhighlight %}
        </div>
        
        <div style="border: 1px solid #ddd; border-radius: 8px; padding: 1rem;">
            <h3>🌊 Ocean Theme</h3>
            <p>Blue ocean-inspired colors</p>
