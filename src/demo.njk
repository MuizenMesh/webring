  size="large"
/>
            {% endhighlight %}
        </div>
        
        <div style="border: 1px solid #ddd; border-radius: 8px; padding: 1rem;">
            <h3>🌅 Sunset Theme</h3>
            <p>Warm orange and yellow colors</p>
